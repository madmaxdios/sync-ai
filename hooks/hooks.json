{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/agent-sync.mjs",
              "--agent",
              "claude",
              "check",
              "--hook"
            ],
            "statusMessage": "sync-ai: checking and synchronizing Claude…",
            "timeout": 8
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/dist/agent-sync.mjs",
              "--agent",
              "claude",
              "check",
              "--hook"
            ],
            "statusMessage": "sync-ai: checking and synchronizing Claude…",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
