{
  "name": "@madmaxdios/sync-ai",
  "version": "0.9.1",
  "type": "module",
  "description": "Sync an allowlisted subset of an AI agent's user-level config through a private git repository.",
  "license": "MIT",
  "homepage": "https://github.com/madmaxdios/sync-ai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madmaxdios/sync-ai.git"
  },
  "bugs": "https://github.com/madmaxdios/sync-ai/issues",
  "bin": {
    "agent-sync": "dist/agent-sync.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "version:patch": "node scripts/bump-version.mjs patch",
    "version:minor": "node scripts/bump-version.mjs minor",
    "test:unit": "npm test",
    "tsc:check": "tsc --noEmit",
    "lint": "eslint .",
    "test:integration": "npm test",
    "test:e2e": "npm test",
    "test": "vitest run",
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
